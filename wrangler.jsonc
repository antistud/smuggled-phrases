{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smuggled-phrases",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "routes": [{ "pattern": "smuggled.qiiver.com", "custom_domain": true }],
  // The built PWA. Unknown paths fall back to index.html; /api/* always hits the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomObject" },
      { "name": "ACCOUNTS", "class_name": "AccountObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomObject"] },
    { "tag": "v2", "new_sqlite_classes": ["AccountObject"] }
  ]
  // Email sign-in: set MAIL_FROM as a var and RESEND_API_KEY as a secret (see README).
}
