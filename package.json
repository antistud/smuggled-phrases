{
  "name": "smuggled-phrases",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Smuggled Phrases — an in-person party game. Nothing to declare. Plenty to say.",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource/special-elite": "^5.3.0",
    "@fontsource/stardos-stencil": "^5.3.0",
    "preact": "^11.2.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  }
}
